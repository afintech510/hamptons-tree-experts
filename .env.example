# Hamptons Tree Experts — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.

# --- Supabase (managed Postgres) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key
# Project Settings -> API -> JWT Settings -> JWT Secret. Used to verify admin
# session tokens server-side (HS256, aud=authenticated).
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Email (Resend or SMTP) ---
EMAIL_FROM=noreply@hamptonstreeexperts.com
EMAIL_API_KEY=re_...

# --- Admin bootstrap (Phase 01) ---
ADMIN_BOOTSTRAP_EMAIL=admin@hamptonstreeexperts.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-on-first-login

# --- App ---
ENVIRONMENT=development
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Analytics (Phase 02) ---
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GADS_ID=AW-XXXXXXXXX

# --- Capacity pause toggle (Phase 02) ---
# Simple shared secret for the manual capacity-pause API endpoint.
# The admin uses this key to toggle the "we're booked" banner.
ADMIN_PAUSE_KEY=change-me-to-a-random-string
